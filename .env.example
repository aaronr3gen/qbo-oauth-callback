# Vercel project Settings -> Environment Variables. Never commit real values.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://qbo-oauth-callback-orcin.vercel.app/api/qbo/callback
QBO_ENVIRONMENT=production
QBO_MINOR_VERSION=75

# Neon/Vercel Postgres connection string. Require TLS in production.
DATABASE_URL=

# base64-encoded 32-byte AES key; generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

# At least 32 random bytes; generate with: openssl rand -base64 48
CONNECT_STATE_SECRET=

# Auth0 issuer must end with a slash. The audience must equal QBO_MCP_RESOURCE.
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com/
AUTH0_AUDIENCE=https://qbo-oauth-callback-orcin.vercel.app
QBO_MCP_RESOURCE=https://qbo-oauth-callback-orcin.vercel.app
QBO_PUBLIC_BASE_URL=https://qbo-oauth-callback-orcin.vercel.app
